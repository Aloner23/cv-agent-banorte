# Proveedor: auto | gemini | anthropic | openai | mock   (auto = el primero con key; sin keys = mock)
LLM_PROVIDER=gemini
# Modelo estable consultado el 2026-10-30; confirmar acceso en la prueba real.
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Si se define, el endpoint exige "Authorization: Bearer <AGENT_API_KEY>"
AGENT_API_KEY=

# full = todo el CV en contexto | retrieval = BM25 top-k
KNOWLEDGE_MODE=full
RATE_LIMIT_PER_MINUTE=30
MAX_OUTPUT_TOKENS=900
MAX_INPUT_CHARS=4000
MAX_HISTORY_TURNS=12
MAX_REQUEST_BYTES=65536
RESPONSE_STORE_MAX_ITEMS=200
RESPONSE_STORE_TTL_SECONDS=3600
REQUEST_TIMEOUT_SECONDS=90
# Vacío = chat del mismo dominio. Agregar sólo orígenes autorizados, separados por comas.
CORS_ORIGINS=
# URL pública sin /v1, para la tarjeta de agente (si falta, se deduce de la solicitud).
PUBLIC_BASE_URL=
# json | text (por defecto json en Cloud Run, text en local)
LOG_FORMAT=

MAX_HISTORY_CHARS=16000
